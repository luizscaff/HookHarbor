@HookHarbor.Api_HostAddress = http://localhost:5226

GET {{HookHarbor.Api_HostAddress}}/health
Accept: text/plain

###
POST {{HookHarbor.Api_HostAddress}}/api/endpoints
Content-Type: application/json
{
  "name": "Worker success test",
  "destinationUrl": "https://webhook.site/YOUR-UNIQUE-ID"
}

###
GET {{HookHarbor.Api_HostAddress}}/api/endpoints/replace-with-created-id
Accept: application/json

###
POST {{HookHarbor.Api_HostAddress}}/in/replace-with-inbound-key
Accept: application/json
Content-Type: application/json
X-Webhook-Source: manual-test

{
  "type": "worker.test",
  "message": "Hello from HookHarbor"
}

###
GET {{HookHarbor.Api_HostAddress}}/api/endpoints/YOUR_ENDPOINT_ID/events?page=1&pageSize=20
Accept: application/json

###
GET {{HookHarbor.Api_HostAddress}}/api/endpoints/YOUR_ENDPOINT_ID/events?status=Failed
Accept: application/json